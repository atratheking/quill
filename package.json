{
  "name": "quill-desktop-local",
  "productName": "Quill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "package:mac": "npm run build && node scripts/package.mjs",
    "package:windows": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "@electron/packager": "^19.0.1",
    "vite": "8.3.4",
    "typescript": "^5.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest"
  }
}
